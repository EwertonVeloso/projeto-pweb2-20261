{
  "name": "financas-webapp",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "0.0.0",
  "type": "module",
 "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w packages/host-app\" \"npm run dev -w packages/mfe-auth\" \"npm run dev -w packages/mfe-transactions\" \"npm run dev -w packages/mfe-dashboard\"",
    "serve": "concurrently \"npm run preview -w packages/host-app\" \"npm run preview -w packages/mfe-auth\" \"npm run preview -w packages/mfe-transactions\" \"npm run preview -w packages/mfe-dashboard\""
  },
  "dependencies": {
    "@financas/shared-types": "*",
    "axios": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
